# Copy this file to .env and fill in your own values. Never commit .env.

# --- Master live-trading switch (also requires live_trading: true in config/settings.yaml) ---
LIVE_TRADING=false

# --- Zerodha Kite Connect (only needed if broker: kite and you intend to go live) ---
# Get these from https://developers.kite.trade after creating a Connect app.
KITE_API_KEY=
KITE_API_SECRET=
# Access tokens expire daily — regenerate each morning via the Kite login flow
# (see swing_agent/broker/kite_broker.py for the login helper).
KITE_ACCESS_TOKEN=

# --- Optional Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
